# Copie este arquivo para ".env" (ou ".env.local") e ajuste se a sua Api
# não estiver rodando em http://localhost:5042.
#
# Toda variável de ambiente que o Vite expõe pro código do navegador
# PRECISA começar com "VITE_" — é uma proteção do próprio Vite pra você
# não vazar sem querer uma variável de ambiente sensível (tipo uma senha
# de banco) pro JavaScript que roda no navegador do cliente.
VITE_API_URL=http://localhost:5042/api
